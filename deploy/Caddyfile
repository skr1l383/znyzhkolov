# Caddy — HTTPS-проксі перед сайтом. Сертифікат Let's Encrypt отримує й оновлює сам.
# Копія лежить у /etc/caddy/Caddyfile; після змін: sudo systemctl reload caddy
# Домен безкоштовний з duckdns.org: znyzhkolov.duckdns.org вказує на IP 92.5.39.234.
znyzhkolov.duckdns.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# Стара адреса (nip.io завжди вказує на IP з назви) — переадресація на нову,
# щоб посилання зі старих листів і закладок працювали.
92-5-39-234.nip.io {
	redir https://znyzhkolov.duckdns.org{uri} permanent
}
