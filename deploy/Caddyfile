# Caddy — HTTPS-проксі перед сайтом. Сертифікат Let's Encrypt отримує й оновлює сам.
# Адреса nip.io безкоштовна: 92-5-39-234.nip.io завжди вказує на IP 92.5.39.234
# (sslip.io працює так само, але DNS деяких провайдерів його не знаходить).
{$SITE_HOST} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
