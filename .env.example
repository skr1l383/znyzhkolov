# Скопіюй цей файл під назвою .env і заповни потрібні значення.
# Усі параметри необов'язкові: без них сайт працює на http://localhost:3000.

# Порт і адреса сайту
PORT=3000
BASE_URL=http://localhost:3000

# Токен Telegram-бота від @BotFather (див. README, розділ «Telegram-бот»)
TELEGRAM_BOT_TOKEN=

# Пошта, яка отримає роль адміністратора під час реєстрації
# (перший зареєстрований користувач стає адміністратором і без цього)
ADMIN_EMAIL=

# Як часто перевіряти (у хвилинах)
CHECK_INTERVAL_MINUTES=180
EPIC_INTERVAL_MINUTES=360
DEALS_INTERVAL_MINUTES=60
RATE_INTERVAL_MINUTES=720

# Регіон магазинів (ціни Steam і Epic у гривнях для UA)
STEAM_COUNTRY=UA
GOG_COUNTRY=UA
EPIC_COUNTRY=UA

# Запасний курс долара, якщо сайт НБУ недоступний
USD_UAH_FALLBACK=45

# 1 = демо-режим із тестовими цінами (те саме, що npm run demo)
DEMO_STORES=0
